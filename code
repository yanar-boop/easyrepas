<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nos repas du soir</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#FDF2F7;
    --bg-card:#FFFFFF;
    --line:#F2D9E4;
    --text:#4A2942;
    --text-dim:#8C6B85;
    --accent:#F2789A;
    --accent-soft:#FDE4ED;
    --mustard:#C9A6E0;
    --mustard-text:#8B5FB0;
    --danger:#E2574F;
    --radius-s:10px;
    --radius-m:16px;
  }
  *{box-sizing:border-box;}
  html{-webkit-text-size-adjust:100%;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'Nunito',sans-serif;
    line-height:1.5;
    padding:0 0 80px;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation:none !important; transition:none !important;}
  }
  .wrap{max-width:820px;margin:0 auto;padding:40px 20px 0;}
  header{margin-bottom:36px;}
  h1{
    font-family:'Quicksand',sans-serif;
    font-weight:600;
    font-size:clamp(28px,5vw,40px);
    margin:0 0 8px;
    letter-spacing:-0.01em;
  }
  .subtitle{color:var(--text-dim);font-size:15px;max-width:52ch;margin:0 0 22px;}
  .date-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:14px;color:var(--text-dim);}
  .date-row input[type=date]{
    background:var(--bg-card);
    border:1px solid var(--line);
    color:var(--text);
    padding:6px 10px;
    border-radius:var(--radius-s);
    font-family:'Nunito',sans-serif;
    font-size:14px;
  }
  .sync-note{margin-top:14px;font-size:13px;color:var(--text-dim);border-left:2px solid var(--mustard);padding-left:10px;}

  .week{margin-bottom:44px;}
  .week-title{
    font-family:'Quicksand',sans-serif;
    font-size:20px;
    font-weight:600;
    color:var(--mustard-text);
    margin:0 0 4px;
  }
  .week-range{color:var(--text-dim);font-size:13px;margin:0 0 14px;}

  .day-row{
    display:grid;
    grid-template-columns:120px 1fr;
    gap:16px;
    align-items:start;
    padding:14px 0;
    border-top:1px solid var(--line);
  }
  .week .day-row:last-child{border-bottom:1px solid var(--line);}
  .day-label{font-family:'Quicksand',sans-serif;font-size:18px;padding-top:6px;}
  .day-date{display:block;font-family:'Nunito',sans-serif;font-size:12px;color:var(--text-dim);font-weight:400;margin-top:2px;}
  .day-main select{
    width:100%;
    background:var(--bg-card);
    color:var(--text);
    border:1px solid var(--line);
    padding:10px 12px;
    border-radius:var(--radius-s);
    font-family:'Nunito',sans-serif;
    font-size:15px;
    appearance:none;
    background-image:linear-gradient(45deg, transparent 50%, var(--text-dim) 50%), linear-gradient(135deg, var(--text-dim) 50%, transparent 50%);
    background-position:calc(100% - 18px) center, calc(100% - 13px) center;
    background-size:5px 5px, 5px 5px;
    background-repeat:no-repeat;
  }
  .day-main select:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}
  .day-tags{margin-top:6px;display:flex;gap:6px;flex-wrap:wrap;min-height:20px;}
  .tag-pill{font-size:11px;padding:2px 8px;border-radius:20px;background:var(--accent-soft);color:var(--text-dim);}

  section.bank{margin-top:52px;}
  .bank-title{font-family:'Quicksand',sans-serif;font-size:22px;font-weight:600;margin:0 0 6px;}
  .bank-sub{color:var(--text-dim);font-size:14px;margin:0 0 20px;max-width:56ch;}

  form.add-form{
    display:grid;
    grid-template-columns:2fr 1.3fr 90px auto;
    gap:10px;
    margin-bottom:24px;
  }
  form.add-form input{
    background:var(--bg-card);
    border:1px solid var(--line);
    color:var(--text);
    padding:10px 12px;
    border-radius:var(--radius-s);
    font-family:'Nunito',sans-serif;
    font-size:14px;
    width:100%;
  }
  form.add-form input::placeholder{color:var(--text-dim);}
  form.add-form input:focus-visible{outline:2px solid var(--accent);outline-offset:1px;}
  form.add-form textarea{
    grid-column:1 / -1;
    background:var(--bg-card);
    border:1px solid var(--line);
    color:var(--text);
    padding:10px 12px;
    border-radius:var(--radius-s);
    font-family:'Nunito',sans-serif;
    font-size:14px;
    width:100%;
    resize:vertical;
    min-height:44px;
  }
  form.add-form textarea::placeholder{color:var(--text-dim);}
  form.add-form textarea:focus-visible{outline:2px solid var(--accent);outline-offset:1px;}
  .add-btn{
    background:#C93F63;
    color:#fff;
    border:none;
    border-radius:var(--radius-s);
    font-family:'Nunito',sans-serif;
    font-weight:700;
    font-size:14px;
    cursor:pointer;
    padding:10px 16px;
  }
  .add-btn:hover{background:#AD3454;}
  .add-btn:focus-visible{outline:2px solid var(--mustard);outline-offset:2px;}

  .recipe-list{display:flex;flex-wrap:wrap;gap:10px;}
  .recipe-chip{
    position:relative;
    background:var(--bg-card);
    border:1px solid var(--line);
    border-radius:var(--radius-m);
    padding:10px 30px 10px 14px;
    font-size:14px;
    max-width:260px;
  }
  .recipe-chip .name{
    font-weight:700;display:block;margin-bottom:3px;
    background:none;border:none;padding:0;text-align:left;
    color:var(--text);font-family:'Nunito',sans-serif;font-size:14px;cursor:pointer;
  }
  .recipe-chip .name:hover{color:var(--mustard-text);}
  .recipe-chip .name:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}
  .pill-complete{background:var(--mustard);color:#3B2250;}
  .tag-pill-btn{
    font-size:11px;padding:2px 8px;border-radius:20px;
    background:transparent;border:1px solid var(--line);color:var(--mustard-text);
    cursor:pointer;font-family:'Nunito',sans-serif;
  }
  .tag-pill-btn:hover{border-color:var(--mustard);}
  .tag-pill-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}
  .recipe-chip .meta{font-size:12px;color:var(--text-dim);}
  .recipe-chip .used{display:inline-block;margin-top:4px;font-size:11px;color:var(--mustard-text);}
  .recipe-chip button.del{
    position:absolute;top:6px;right:6px;
    background:transparent;border:none;color:var(--text-dim);
    cursor:pointer;font-size:15px;line-height:1;padding:4px;border-radius:50%;
  }
  .recipe-chip button.del:hover{color:var(--danger);}
  .recipe-chip button.del:focus-visible{outline:2px solid var(--accent);}

  .status-line{font-size:12px;color:var(--text-dim);margin-top:8px;min-height:16px;}
  .empty{color:var(--text-dim);font-size:14px;font-style:italic;}

  .modal-overlay{
    position:fixed;inset:0;background:rgba(74,41,66,0.45);
    display:flex;align-items:flex-end;justify-content:center;
    z-index:50;
  }
  .modal-overlay.hidden{display:none;}
  @media (min-width:560px){
    .modal-overlay{align-items:center;padding:20px;}
  }
  .modal-box{
    background:var(--bg-card);
    border:1px solid var(--line);
    border-radius:var(--radius-m) var(--radius-m) 0 0;
    width:100%;max-width:480px;
    max-height:85vh;overflow-y:auto;
    padding:22px 22px 26px;
  }
  @media (min-width:560px){
    .modal-box{border-radius:var(--radius-m);}
  }
  .modal-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;}
  .modal-title{font-family:'Quicksand',sans-serif;font-size:20px;font-weight:600;margin:0;}
  .modal-close{background:transparent;border:none;color:var(--text-dim);font-size:22px;cursor:pointer;padding:2px 6px;line-height:1;}
  .modal-close:hover{color:var(--danger);}
  .modal-close:focus-visible{outline:2px solid var(--accent);}
  .modal-sub{font-size:13px;color:var(--text-dim);margin:6px 0 16px;}
  .ingredient-row{display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--line);}
  .ingredient-row:first-of-type{border-top:none;}
  .ingredient-row input[type=checkbox]{width:19px;height:19px;flex:none;accent-color:var(--accent);}
  .ingredient-row label{font-size:15px;cursor:pointer;}
  .ingredient-row.checked label{color:var(--text-dim);text-decoration:line-through;}
  .modal-actions{display:flex;justify-content:space-between;align-items:center;margin-top:16px;gap:10px;flex-wrap:wrap;}
  .modal-toggle-all{
    background:transparent;border:1px solid var(--line);color:var(--text);
    padding:8px 14px;border-radius:var(--radius-s);font-size:13px;cursor:pointer;font-family:'Nunito',sans-serif;
  }
  .modal-toggle-all:hover{border-color:var(--mustard);}
  .modal-toggle-all:focus-visible{outline:2px solid var(--accent);}
  .modal-empty{color:var(--text-dim);font-size:14px;font-style:italic;}

  section.shopping{margin-top:52px;}
  .shopping-count{font-size:13px;color:var(--mustard-text);margin:0 0 16px;}
  .shopping-grid{display:flex;flex-wrap:wrap;gap:8px;}
  .shopping-item{
    background:var(--bg-card);
    border:1px solid var(--line);
    border-radius:20px;
    padding:6px 14px;
    font-size:14px;
  }
  .shopping-item .count{color:var(--mustard-text);font-size:12px;margin-left:4px;}

  @media (max-width:560px){
    .day-row{grid-template-columns:1fr;}
    .day-label{padding-top:0;}
    form.add-form{grid-template-columns:1fr;}
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Nos repas du soir</h1>
    <p class="subtitle">Deux semaines de dîners, remplies à deux. Chaque recette ne peut être choisie qu'un seul soir sur la période.</p>
    <div class="date-row">
      <label for="startDate">Lundi de la semaine 1 :</label>
      <input type="date" id="startDate">
    </div>
    <p class="sync-note">Cette page est partagée : toute personne avec ce lien peut voir et modifier le planning et la liste de recettes.</p>
  </header>

  <div id="weeks"></div>

  <section class="shopping" id="shoppingSection">
    <h2 class="bank-title">Liste de courses</h2>
    <p class="bank-sub">Le total de tout ce qu'il reste à acheter pour les repas actuellement prévus sur les deux semaines. Ce qui est coché comme "déjà à la maison" dans une recette n'y apparaît plus.</p>
    <p class="shopping-count" id="shoppingCount"></p>
    <div id="shoppingList"></div>
  </section>

  <section class="bank">
    <h2 class="bank-title">Banque de recettes</h2>
    <p class="bank-sub">Ajoutez, modifiez ou supprimez librement. Une recette supprimée disparaît aussi du planning.</p>
    <form class="add-form" id="addForm">
      <input type="text" id="newName" placeholder="Nom du repas" required>
      <input type="text" id="newTags" placeholder="Tags (ex: rapide, kids ok)">
      <input type="number" id="newTime" placeholder="Min" min="0">
      <button class="add-btn" type="submit">Ajouter</button>
      <textarea id="newIngredients" rows="1" placeholder="Ingrédients avec quantités, séparés par une virgule — ex: 400 g pâtes, 400 g bœuf haché, 1 oignon"></textarea>
    </form>
    <button class="modal-toggle-all" id="refreshQuantitiesBtn" type="button" style="margin-bottom:18px;">Mettre à jour les quantités des recettes de base (2 adultes + 2 enfants)</button>
    <div class="recipe-list" id="recipeList"></div>
    <p class="status-line" id="statusLine"></p>
  </section>
</div>

<div class="modal-overlay hidden" id="accessOverlay">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="accessTitle">
    <div class="modal-head">
      <h3 class="modal-title" id="accessTitle">Code d'accès</h3>
    </div>
    <p class="modal-sub">Entre le code à 4 chiffres partagé avec ton foyer pour voir et modifier le planning.</p>
    <form id="accessForm" style="display:flex;gap:10px;">
      <input type="text" id="accessInput" inputmode="numeric" pattern="[0-9]*" maxlength="4"
             placeholder="••••" autocomplete="off"
             style="flex:1;background:var(--bg);border:1px solid var(--line);color:var(--text);padding:12px;border-radius:var(--radius-s);font-size:20px;letter-spacing:6px;text-align:center;">
      <button class="add-btn" type="submit">Valider</button>
    </form>
    <p class="status-line" id="accessStatus"></p>
  </div>
</div>

<div class="modal-overlay hidden" id="checklistOverlay">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="checklistTitle">
    <div class="modal-head">
      <h3 class="modal-title" id="checklistTitle"></h3>
      <button class="modal-close" id="checklistClose" type="button" aria-label="Fermer">×</button>
    </div>
    <p class="modal-sub">Coche ce que tu as déjà à la maison pour repérer ce qui manque.</p>
    <div id="checklistBody"></div>
    <div class="modal-actions">
      <button class="modal-toggle-all" id="checklistToggleAll" type="button">Tout cocher</button>
      <span class="status-line" id="checklistStatus"></span>
    </div>
  </div>
</div>

<script>
const DAY_NAMES = ["Lundi","Mardi","Mercredi","Jeudi","Vendredi","Samedi","Dimanche"];
const RECIPES_KEY = "recipes";
const PLAN_KEY = "plan";
const START_KEY = "startDate";
const CHECKS_KEY = "checks";

const DEFAULT_RECIPES = [
  {name:"Pâtes à la bolognaise maison", tags:"rapide, kids ok", time:30,
   ingredients:["400 g pâtes","400 g bœuf haché","1 oignon","400 g tomates pelées (boîte)","2 gousses d'ail","2 c. à soupe huile d'olive"]},
  {name:"Poulet rôti, purée de patates douces", tags:"kids ok", time:50,
   ingredients:["1 poulet entier (env. 1,2 kg)","800 g patates douces","30 g beurre","100 ml lait","2 branches de thym"]},
  {name:"Gratin de poisson blanc et brocolis", tags:"léger", time:40,
   ingredients:["500 g filets de poisson blanc","500 g brocolis","200 ml crème fraîche","80 g gruyère râpé","20 g farine"]},
  {name:"Riz cantonais aux légumes et œuf", tags:"rapide, kids ok", time:20,
   ingredients:["300 g riz","3 œufs","150 g petits pois","150 g carottes","100 g jambon","2 c. à soupe sauce soja"]},
  {name:"Tacos de bœuf haché maison", tags:"kids ok", time:25,
   ingredients:["8 tortillas","400 g bœuf haché","2 tomates","1/4 salade","100 g fromage râpé","1 sachet épices tacos"]},
  {name:"Curry de lentilles corail doux", tags:"léger, végé", time:30,
   ingredients:["250 g lentilles corail","400 ml lait de coco","1 oignon","1 c. à soupe curry doux","300 g riz"]},
  {name:"Nuggets de poulet maison, potatoes et salade", tags:"kids ok", time:35,
   ingredients:["500 g blancs de poulet","100 g chapelure","2 œufs","600 g pommes de terre","1 salade verte"]},
  {name:"Quiche jambon-fromage, salade verte", tags:"rapide", time:35,
   ingredients:["1 pâte brisée","150 g jambon","150 g gruyère râpé","3 œufs","200 ml crème fraîche","1 salade verte"]},
  {name:"Saumon en papillote, riz et haricots verts", tags:"léger", time:30,
   ingredients:["4 pavés de saumon (adapter la taille pour les enfants)","1 citron","300 g riz","400 g haricots verts"]},
  {name:"Pizza maison (pâte + garnitures au choix)", tags:"kids ok", time:40,
   ingredients:["2 pâtes à pizza","200 g sauce tomate","250 g mozzarella","garnitures au choix (jambon, champignons...)"]},
  {name:"Boulettes de dinde sauce tomate, coquillettes", tags:"kids ok", time:35,
   ingredients:["500 g dinde hachée","50 g chapelure","1 œuf","400 g coulis de tomate","400 g coquillettes"]},
  {name:"Wraps au poulet et crudités", tags:"rapide, kids ok", time:20,
   ingredients:["8 tortillas","400 g blancs de poulet","1/4 salade","2 tomates","sauce au choix"]},
  {name:"Soupe de légumes et croque-monsieur", tags:"léger, kids ok", time:25,
   ingredients:["800 g légumes de saison","1 l bouillon","8 tranches de pain de mie","150 g jambon","150 g gruyère râpé"]},
  {name:"Chili con carne doux, riz", tags:"kids ok", time:35,
   ingredients:["400 g bœuf haché","400 g haricots rouges (boîte)","400 g tomates pelées","1 oignon","300 g riz","1 sachet épices douces"]}
];

let recipes = [];
let plan = {};
let startDate = null;
let checks = {};

const statusLine = document.getElementById("statusLine");
function setStatus(msg){ statusLine.textContent = msg; }

function uid(){ return 'r' + Date.now() + Math.floor(Math.random()*1000); }

// --- Backend: Google Apps Script Web App (replaces Claude's window.storage) ---
const BACKEND_URL = "https://script.google.com/macros/s/AKfycbxf1RNTg9qTlJqe3kq7y-AXFVJCgq5IGuT26H-JqW1UFCYcSdbcpGCxjgcaNy47xKmX/exec";
const ACCESS_CODE_STORAGE_KEY = "meal_planner_access_code";

function getStoredAccessCode(){
  try{ return localStorage.getItem(ACCESS_CODE_STORAGE_KEY) || ""; }
  catch(e){ return ""; }
}
function setStoredAccessCode(code){
  try{ localStorage.setItem(ACCESS_CODE_STORAGE_KEY, code); }catch(e){ /* ignore */ }
}
function clearStoredAccessCode(){
  try{ localStorage.removeItem(ACCESS_CODE_STORAGE_KEY); }catch(e){ /* ignore */ }
}

// Google Apps Script web apps don't return CORS headers that fetch() can read,
// so GET requests go through JSONP (a <script> tag isn't subject to CORS).
function cloudGet(key){
  return new Promise((resolve, reject) => {
    const callbackName = "cb_" + Math.random().toString(36).slice(2);
    const timeoutId = setTimeout(() => { cleanup(); reject(new Error("timeout")); }, 8000);

    function cleanup(){
      clearTimeout(timeoutId);
      delete window[callbackName];
      if(script.parentNode) script.parentNode.removeChild(script);
    }

    window[callbackName] = (data) => {
      cleanup();
      if(data && data.error){ reject(new Error(data.error)); return; }
      resolve((data && data.value !== undefined && data.value !== null) ? data.value : null);
    };

    const code = getStoredAccessCode();
    const script = document.createElement("script");
    script.src = BACKEND_URL + "?key=" + encodeURIComponent(key) + "&code=" + encodeURIComponent(code) + "&callback=" + callbackName;
    script.onerror = () => { cleanup(); reject(new Error("script load error")); };
    document.body.appendChild(script);
  });
}

// Writes use no-cors: the browser can't read the response, but the request
// still reaches and runs on the server, which is all a save needs.
async function cloudSet(key, value){
  await fetch(BACKEND_URL, {
    method: "POST",
    mode: "no-cors",
    headers: { "Content-Type": "text/plain;charset=utf-8" },
    body: JSON.stringify({ key, value, code: getStoredAccessCode() })
  });
}

function showAccessModal(message){
  document.getElementById("accessOverlay").classList.remove("hidden");
  document.getElementById("accessStatus").textContent = message || "";
  const input = document.getElementById("accessInput");
  input.value = "";
  input.focus();
}
function hideAccessModal(){
  document.getElementById("accessOverlay").classList.add("hidden");
}

document.getElementById("accessForm").addEventListener("submit", (e) => {
  e.preventDefault();
  const val = document.getElementById("accessInput").value.trim();
  if(!/^[0-9]{4}$/.test(val)){
    document.getElementById("accessStatus").textContent = "Entre les 4 chiffres du code.";
    return;
  }
  setStoredAccessCode(val);
  document.getElementById("accessStatus").textContent = "Vérification…";
  loadAll();
});

async function loadAll(){
  if(!getStoredAccessCode()){
    showAccessModal("");
    return;
  }
  setStatus("Chargement…");
  let warning = "";

  // Recipes: get, or fall back to defaults. Parsing errors also fall back
  // to defaults so the dropdown is never left empty.
  let rVal = null;
  try{ rVal = await cloudGet(RECIPES_KEY); }
  catch(e){
    if(e.message === "forbidden"){
      clearStoredAccessCode();
      showAccessModal("Code incorrect, réessaie.");
      return;
    }
    rVal = null;
    warning = "Connexion au serveur impossible pour le moment. Réessaie dans un instant.";
  }

  hideAccessModal();

  if(rVal){
    try{ recipes = JSON.parse(rVal); }
    catch(e){ recipes = DEFAULT_RECIPES.map(x => ({id: uid(), ...x})); }
  } else if(!warning){
    recipes = DEFAULT_RECIPES.map(x => ({id: uid(), ...x}));
    try{ await cloudSet(RECIPES_KEY, JSON.stringify(recipes)); }
    catch(e){ warning = "Impossible de synchroniser pour le moment. La liste reste visible, réessayez plus tard."; }
  }

  if(!warning){
    try{
      const pVal = await cloudGet(PLAN_KEY);
      plan = pVal ? JSON.parse(pVal) : {};
    }catch(e){ plan = {}; }

    try{
      const sVal = await cloudGet(START_KEY);
      startDate = sVal || null;
    }catch(e){ startDate = null; }

    try{
      const cVal = await cloudGet(CHECKS_KEY);
      checks = cVal ? JSON.parse(cVal) : {};
    }catch(e){ checks = {}; }
  }

  document.getElementById("startDate").value = startDate || "";
  render();
  setStatus(warning);
}

async function saveRecipes(){
  try{ await cloudSet(RECIPES_KEY, JSON.stringify(recipes)); }
  catch(e){ setStatus("La sauvegarde des recettes a échoué. Réessayez."); }
}
async function savePlan(){
  try{ await cloudSet(PLAN_KEY, JSON.stringify(plan)); }
  catch(e){ setStatus("La sauvegarde du planning a échoué. Réessayez."); }
}
async function saveStartDate(){
  try{ await cloudSet(START_KEY, startDate || ""); }
  catch(e){ /* non-critical */ }
}
async function saveChecks(){
  try{ await cloudSet(CHECKS_KEY, JSON.stringify(checks)); }
  catch(e){ setStatus("La sauvegarde des ingrédients cochés a échoué. Réessayez."); }
}

function fmtDate(baseISO, offsetDays){
  if(!baseISO) return "";
  const d = new Date(baseISO + "T00:00:00");
  d.setDate(d.getDate() + offsetDays);
  return d.toLocaleDateString('fr-FR', {day:'numeric', month:'short'});
}

function usedElsewhere(dayKey, recipeId){
  return Object.entries(plan).some(([k,v]) => k !== dayKey && v === recipeId);
}

function render(){
  renderWeeks();
  renderShoppingList();
  renderRecipeList();
}

// Sums the ingredients of every recipe currently assigned to a day across
// both weeks. An ingredient already checked "at home" on a given recipe's
// checklist is left out of the total — the total tracks what's left to buy.
function computeShoppingTotals(){
  const totals = {};
  Object.entries(plan).forEach(([dayKey, recId]) => {
    const rec = recipes.find(r => r.id === recId);
    if(!rec || !rec.ingredients) return;
    const recChecks = checks[rec.id] || {};
    rec.ingredients.forEach((ing, i) => {
      if(recChecks[i]) return;
      const label = ing.trim();
      if(!label) return;
      const key = label.toLowerCase();
      if(!totals[key]) totals[key] = { label, count: 0 };
      totals[key].count++;
    });
  });
  return Object.values(totals).sort((a,b) => a.label.localeCompare(b.label, 'fr'));
}

function renderShoppingList(){
  const container = document.getElementById("shoppingList");
  const countLine = document.getElementById("shoppingCount");
  container.innerHTML = "";
  const plannedCount = Object.keys(plan).length;

  if(plannedCount === 0){
    countLine.textContent = "";
    const p = document.createElement("p");
    p.className = "empty";
    p.textContent = "Choisis des repas dans le planning pour voir la liste se remplir.";
    container.appendChild(p);
    return;
  }

  const totals = computeShoppingTotals();
  if(totals.length === 0){
    countLine.textContent = plannedCount + " repas prévu(s).";
    const p = document.createElement("p");
    p.className = "empty";
    p.textContent = "Tout est déjà coché comme disponible — rien à acheter pour l'instant.";
    container.appendChild(p);
    return;
  }

  countLine.textContent = totals.length + " ingrédient(s) à acheter, pour " + plannedCount + " repas prévu(s).";
  const grid = document.createElement("div");
  grid.className = "shopping-grid";
  totals.forEach(item => {
    const el = document.createElement("span");
    el.className = "shopping-item";
    el.textContent = item.label;
    if(item.count > 1){
      const c = document.createElement("span");
      c.className = "count";
      c.textContent = "× " + item.count;
      el.appendChild(c);
    }
    grid.appendChild(el);
  });
  container.appendChild(grid);
}

function renderWeeks(){
  const container = document.getElementById("weeks");
  container.innerHTML = "";
  for(let w=0; w<2; w++){
    const weekEl = document.createElement("div");
    weekEl.className = "week";
    const title = document.createElement("p");
    title.className = "week-title";
    title.textContent = "Semaine " + (w+1);
    weekEl.appendChild(title);

    if(startDate){
      const range = document.createElement("p");
      range.className = "week-range";
      range.textContent = fmtDate(startDate, w*7) + " → " + fmtDate(startDate, w*7+6);
      weekEl.appendChild(range);
    }

    for(let d=0; d<7; d++){
      const dayIndex = w*7 + d;
      const dayKey = "day_" + dayIndex;
      const row = document.createElement("div");
      row.className = "day-row";

      const label = document.createElement("div");
      label.className = "day-label";
      label.textContent = DAY_NAMES[d];
      if(startDate){
        const span = document.createElement("span");
        span.className = "day-date";
        span.textContent = fmtDate(startDate, dayIndex);
        label.appendChild(span);
      }
      row.appendChild(label);

      const main = document.createElement("div");
      main.className = "day-main";

      const select = document.createElement("select");
      select.setAttribute("aria-label", "Repas du " + DAY_NAMES[d] + " soir");
      const emptyOpt = document.createElement("option");
      emptyOpt.value = "";
      emptyOpt.textContent = "— Choisir un repas —";
      select.appendChild(emptyOpt);

      const currentValue = plan[dayKey] || "";
      recipes.slice().sort((a,b) => a.name.localeCompare(b.name, 'fr')).forEach(rec => {
        if(rec.id !== currentValue && usedElsewhere(dayKey, rec.id)) return;
        const opt = document.createElement("option");
        opt.value = rec.id;
        opt.textContent = rec.name;
        if(rec.id === currentValue) opt.selected = true;
        select.appendChild(opt);
      });

      select.addEventListener("change", async (e) => {
        const val = e.target.value;
        if(val) plan[dayKey] = val;
        else delete plan[dayKey];
        await savePlan();
        render();
        if(val){
          const rec = recipes.find(r => r.id === val);
          if(rec) openChecklist(rec);
        }
      });

      main.appendChild(select);

      const chosen = recipes.find(r => r.id === plan[dayKey]);
      const tagsEl = document.createElement("div");
      tagsEl.className = "day-tags";
      if(chosen){
        if(chosen.time){
          const p = document.createElement("span");
          p.className = "tag-pill";
          p.textContent = chosen.time + " min";
          tagsEl.appendChild(p);
        }
        (chosen.tags || "").split(",").map(t=>t.trim()).filter(Boolean).forEach(t=>{
          const p = document.createElement("span");
          p.className = "tag-pill";
          p.textContent = t;
          tagsEl.appendChild(p);
        });
        if(chosen.ingredients && chosen.ingredients.length){
          const recChecks = checks[chosen.id] || {};
          const got = chosen.ingredients.filter((_,i)=>recChecks[i]).length;
          const ingBtn = document.createElement("button");
          ingBtn.type = "button";
          ingBtn.className = "tag-pill-btn";
          ingBtn.textContent = "Ingrédients : " + got + "/" + chosen.ingredients.length;
          ingBtn.addEventListener("click", () => openChecklist(chosen));
          tagsEl.appendChild(ingBtn);
        }
      }
      main.appendChild(tagsEl);

      row.appendChild(main);
      weekEl.appendChild(row);
    }
    container.appendChild(weekEl);
  }
}

function renderRecipeList(){
  const list = document.getElementById("recipeList");
  list.innerHTML = "";
  if(recipes.length === 0){
    const p = document.createElement("p");
    p.className = "empty";
    p.textContent = "Aucune recette pour l'instant.";
    list.appendChild(p);
    return;
  }
  const sorted = recipes.slice().sort((a,b) => a.name.localeCompare(b.name, 'fr'));
  sorted.forEach(rec => {
    const chip = document.createElement("div");
    chip.className = "recipe-chip";

    const name = document.createElement("button");
    name.type = "button";
    name.className = "name";
    name.textContent = rec.name;
    name.setAttribute("aria-label", "Voir les ingrédients de " + rec.name);
    name.addEventListener("click", () => openChecklist(rec));
    chip.appendChild(name);

    const meta = document.createElement("span");
    meta.className = "meta";
    const bits = [];
    if(rec.time) bits.push(rec.time + " min");
    if(rec.tags) bits.push(rec.tags);
    meta.textContent = bits.join(" · ");
    chip.appendChild(meta);

    if(rec.ingredients && rec.ingredients.length){
      const recChecks = checks[rec.id] || {};
      const got = rec.ingredients.filter((_,i)=>recChecks[i]).length;
      const total = rec.ingredients.length;
      const pill = document.createElement("span");
      pill.className = "tag-pill" + (got === total ? " pill-complete" : "");
      pill.style.display = "inline-block";
      pill.style.marginTop = "4px";
      pill.textContent = "Ingrédients : " + got + "/" + total;
      chip.appendChild(document.createElement("br"));
      chip.appendChild(pill);
    }

    const usedDayKey = Object.entries(plan).find(([k,v]) => v === rec.id);
    if(usedDayKey){
      const idx = parseInt(usedDayKey[0].replace("day_",""), 10);
      const week = Math.floor(idx/7)+1;
      const day = DAY_NAMES[idx%7];
      const used = document.createElement("span");
      used.className = "used";
      used.textContent = "Prévue : " + day + " (S" + week + ")";
      chip.appendChild(document.createElement("br"));
      chip.appendChild(used);
    }

    const del = document.createElement("button");
    del.className = "del";
    del.type = "button";
    del.setAttribute("aria-label", "Supprimer " + rec.name);
    del.textContent = "×";
    del.addEventListener("click", async () => {
      recipes = recipes.filter(r => r.id !== rec.id);
      Object.keys(plan).forEach(k => { if(plan[k] === rec.id) delete plan[k]; });
      delete checks[rec.id];
      await saveRecipes();
      await savePlan();
      await saveChecks();
      render();
    });
    chip.appendChild(del);

    list.appendChild(chip);
  });
}

document.getElementById("addForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const nameInput = document.getElementById("newName");
  const tagsInput = document.getElementById("newTags");
  const timeInput = document.getElementById("newTime");
  const ingredientsInput = document.getElementById("newIngredients");
  const name = nameInput.value.trim();
  if(!name) return;
  recipes.push({
    id: uid(),
    name,
    tags: tagsInput.value.trim(),
    time: timeInput.value ? parseInt(timeInput.value,10) : null,
    ingredients: ingredientsInput.value.split(",").map(s => s.trim()).filter(Boolean)
  });
  nameInput.value = ""; tagsInput.value = ""; timeInput.value = ""; ingredientsInput.value = "";
  await saveRecipes();
  render();
});

document.getElementById("refreshQuantitiesBtn").addEventListener("click", async () => {
  let updated = 0;
  recipes = recipes.map(rec => {
    const match = DEFAULT_RECIPES.find(d => d.name === rec.name);
    if(match){
      updated++;
      return { ...rec, ingredients: match.ingredients.slice() };
    }
    return rec;
  });
  await saveRecipes();
  render();
  setStatus(updated > 0
    ? updated + " recette(s) mise(s) à jour avec les quantités pour 2 adultes + 2 enfants."
    : "Aucune recette de base à mettre à jour (tu utilises déjà tes propres versions).");
});

// --- Ingredient checklist modal ---
let currentChecklistRecipeId = null;
const checklistOverlay = document.getElementById("checklistOverlay");
const checklistTitle = document.getElementById("checklistTitle");
const checklistBody = document.getElementById("checklistBody");
const checklistStatus = document.getElementById("checklistStatus");
const checklistToggleAll = document.getElementById("checklistToggleAll");
const checklistClose = document.getElementById("checklistClose");

function openChecklist(rec){
  if(!rec) return;
  currentChecklistRecipeId = rec.id;
  checklistTitle.textContent = rec.name;
  renderChecklistBody(rec);
  checklistOverlay.classList.remove("hidden");
  checklistClose.focus();
}
function closeChecklist(){
  checklistOverlay.classList.add("hidden");
  currentChecklistRecipeId = null;
}
function updateChecklistStatus(rec){
  const ingredients = rec.ingredients || [];
  const recChecks = checks[rec.id] || {};
  const got = ingredients.filter((_, i) => recChecks[i]).length;
  checklistStatus.textContent = ingredients.length ? (got + " / " + ingredients.length + " en stock") : "";
}
function renderChecklistBody(rec){
  checklistBody.innerHTML = "";
  const ingredients = rec.ingredients || [];
  if(ingredients.length === 0){
    const p = document.createElement("p");
    p.className = "modal-empty";
    p.textContent = "Aucun ingrédient renseigné pour cette recette. Tu peux la supprimer et la recréer avec une liste d'ingrédients, ou me demander de l'ajouter.";
    checklistBody.appendChild(p);
    checklistToggleAll.style.display = "none";
    checklistStatus.textContent = "";
    return;
  }
  checklistToggleAll.style.display = "";
  const recChecks = checks[rec.id] || {};
  ingredients.forEach((ing, i) => {
    const row = document.createElement("div");
    row.className = "ingredient-row" + (recChecks[i] ? " checked" : "");
    const cb = document.createElement("input");
    cb.type = "checkbox";
    cb.id = "ing_" + rec.id + "_" + i;
    cb.checked = !!recChecks[i];
    cb.addEventListener("change", async () => {
      if(!checks[rec.id]) checks[rec.id] = {};
      checks[rec.id][i] = cb.checked;
      row.classList.toggle("checked", cb.checked);
      updateChecklistStatus(rec);
      await saveChecks();
      render();
    });
    const lbl = document.createElement("label");
    lbl.setAttribute("for", cb.id);
    lbl.textContent = ing;
    row.appendChild(cb);
    row.appendChild(lbl);
    checklistBody.appendChild(row);
  });
  updateChecklistStatus(rec);
}
checklistToggleAll.addEventListener("click", async () => {
  const rec = recipes.find(r => r.id === currentChecklistRecipeId);
  if(!rec) return;
  const ingredients = rec.ingredients || [];
  const recChecks = checks[rec.id] || {};
  const allChecked = ingredients.length > 0 && ingredients.every((_, i) => recChecks[i]);
  const newChecks = {};
  ingredients.forEach((_, i) => { newChecks[i] = !allChecked; });
  checks[rec.id] = newChecks;
  renderChecklistBody(rec);
  await saveChecks();
  render();
});
checklistClose.addEventListener("click", closeChecklist);
checklistOverlay.addEventListener("click", (e) => { if(e.target === checklistOverlay) closeChecklist(); });
document.addEventListener("keydown", (e) => {
  if(e.key === "Escape" && !checklistOverlay.classList.contains("hidden")) closeChecklist();
});

document.getElementById("startDate").addEventListener("change", async (e) => {
  startDate = e.target.value || null;
  await saveStartDate();
  render();
});

loadAll();
</script>
